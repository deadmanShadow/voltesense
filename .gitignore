# Secrets & local config — NEVER commit
*.env
*.env.local
appsettings.*.local.json
**/appsettings.Development.json
**/secrets.json
**/appsettings.*.Production.json

# EF Core migrations should be committed (excluded by default in some templates):
# !src/**/Persistence/Migrations/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Local databases & logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Local tool configs (Claude / puku-cli state, etc.)
.puku-cli/settings.local.json
.claude/settings.local.json
.aider*
.continue

# Node / npm scratch (used only for one-off YAML linting)
node_modules/
package.json
package-lock.json
